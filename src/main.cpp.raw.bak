#include <Arduino.h>
#include "WaterMeter.h"
#include "hwconfig.h"

WaterMeter waterMeter;

// Dessa funktioner förväntas av resten av projektet.
// I vårt test skriver vi bara allt till Serial i stället för MQTT.

void mqttDebugRf(const char* str)
{
    Serial.print("[RF] ");
    Serial.println(str);
}

void mqttDebugRaw(const char* str)
{
    Serial.print("[RAW] ");
    Serial.println(str);
}

void mqttDebugRecord(const char* str)
{
    Serial.print("[REC] ");
    Serial.println(str);
}

void mqttMyData(const char* str)
{
    Serial.print("[DATA] ");
    Serial.println(str);
}

void mqttMyDataJson(const char* str)
{
    Serial.print("[JSON] ");
    Serial.println(str);
}

void setup()
{
    Serial.begin(115200);
    delay(1000);

    Serial.println();
    Serial.println("==============================");
    Serial.println("Wireless M-Bus listener");
    Serial.println("ESP32 + CC1101");
    Serial.println("No WiFi / MQTT / DEK");
    Serial.println("==============================");

    Serial.println("Starting CC1101...");
    waterMeter.begin();

    Serial.println("CC1101 started.");
    Serial.println("Listening for Wireless M-Bus packets...");
    Serial.println();
}

void loop()
{
    waterMeter.isFrameAvailable();
}